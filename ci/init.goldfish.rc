# Ersatz fuer die Goldfish-Variante: virtio-Platten statt MTD, keine qemud/GSM-Dienste.
# WICHTIG: Das Original-init.goldfish.sh (Netzwerk 10.0.2.15) wird hier ersetzt,
# daher muss eth0 selbst konfiguriert werden - sonst erreicht hostfwd :5555 den adbd nie.
on early-init
    mount debugfs debugfs /sys/kernel/debug
    # URSACHE (dritter Lauf): zygote stuerzt beim Preload mit NullPointerException in android.os.Debug ab
    # ("EXTERNAL_STORAGE undefined"): Environment.getLegacyExternalStorageDirectory() macht
    # new File(System.getenv("EXTERNAL_STORAGE")). Das Original setzt die Variable in seiner
    # init.goldfish.rc/Storage-Konfiguration, die wir ersetzen -> hier selbst exportieren.
    export EXTERNAL_STORAGE /storage/sdcard0
    export SECONDARY_STORAGE /storage/sdcard1

on fs
    # QEMU "virt" vergibt virtio-mmio-Slots in umgekehrter Reihenfolge:
    # das ERSTE -drive (system.img) erscheint im Gast als vdb, das ZWEITE (data) als vda.
    mount ext4 /dev/block/vdb /system ro barrier=1
    mount ext4 /dev/block/vda /data nosuid nodev noatime barrier=0
    # URSACHE des Boot-Hangs: Das Original macht "mount_all /fstab.goldfish"; fs_mgr loest
    # dabei den Trigger "nonencrypted" aus, und erst der startet "class_start main"
    # (zygote, surfaceflinger, mediaserver ...). Da wir manuell mounten, muessen wir ihn selbst
    # ausloesen - sonst laeuft nur adbd, sys.boot_completed wird nie 1, Bildschirm bleibt schwarz.
    # URSACHE (Lauf 5/6): Unter QEMU-TCG (1 vCPU) ist der Erststart so langsam, dass der Watchdog system_server
    # mehrfach abschiesst (sysrq "Show Blocked State" in der Konsole) und der lowmemorykiller anspringt.
    # Groesste CPU-Fresser: Bootanimation (Software-Rendering) und dexopt mit Verifizierung/Optimierung.
    # Beides abschalten. (Hier gesetzt, weil build.prop vorher geladen wird und sonst ueberschreiben wuerde.)
    setprop debug.sf.nobootanimation 1
    setprop dalvik.vm.dexopt-flags v=n,o=n
    setprop ro.crypto.state unencrypted
    # SF meldet sonst "ro.sf.lcd_density must be defined as a build property"
    setprop ro.sf.lcd_density 160
    trigger nonencrypted

# surfaceflinger frass unter TCG ~92 % der einzigen vCPU -> system_server verhungert, Watchdog-Neustart-Schleife.
# Nach jedem (Neu-)Start von SF dessen Hauptthread drosseln (Skript liegt im Ramdisk-Root).
on property:init.svc.surfaceflinger=running
    start sf-throttle

service sf-throttle /system/bin/sh /sf-throttle.sh 10
    user root
    group root
    oneshot
    disabled

on post-fs-data
    setprop vold.post_fs_data_done 1

on boot
    setprop net.eth0.gw 10.0.2.2
    setprop net.eth0.dns1 10.0.2.3
    setprop net.dns1 10.0.2.3
    setprop ro.radio.use-ppp no
    setprop persist.sys.usb.config adb
    setprop service.adb.tcp.port 5555
    start net-ifup
    start adbd

# eth0 konfigurieren (wie init.goldfish.sh), danach Default-Route setzen
service net-ifup /system/bin/ifconfig eth0 10.0.2.15 netmask 255.255.255.0 up
    user root
    group root
    oneshot
    disabled

on property:init.svc.net-ifup=stopped
    start net-route

service net-route /system/bin/route add default gw 10.0.2.2 dev eth0
    user root
    group root
    oneshot
    disabled
